{
  "id": "lgsm-wurm",
  "name": "Wurm Unlimited",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 402370,
  "start": "./WurmServerLauncher start={{gamemode}} adminpwd='{{adminpassword}}' epicsettings='false' externalport='{{port}}' homeserver='true' homekingdom='4' loginserver='true' maxplayers='{{maxplayers}}' queryport='{{port_2}}' rmiport='{{port_3}}' rmiregport='{{port_4}}' servername='{{servername}}' serverpassword='{{serverpassword}}' ip='0.0.0.0'",
  "ports": [
    {
      "name": "Game",
      "port": 3724,
      "proto": "tcp"
    },
    {
      "name": "Query",
      "port": 27016,
      "proto": "udp"
    },
    {
      "name": "RMI",
      "port": 7221,
      "proto": "tcp"
    },
    {
      "name": "RMI Registry",
      "port": 7220,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "adminpassword",
      "label": "Admin-Passwort",
      "default": "",
      "type": "secret"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "200",
      "type": "number"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "Creative",
      "type": "slug"
    },
    {
      "key": "serverpassword",
      "label": "Server-Passwort",
      "default": "",
      "type": "secret"
    }
  ],
  "memory_mb": 4096,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "packages": [
    "xvfb"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
