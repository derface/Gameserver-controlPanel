{
  "id": "lgsm-sven",
  "name": "Sven Co-op",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 276060,
  "start": "./svends_run -game svencoop -strictportbind +ip 0.0.0.0 -port {{port}} +clientport {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg +maxplayers {{maxplayers}}",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "svencoop1",
      "type": "slug"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    }
  ],
  "memory_mb": 512,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (svencoop/panel.cfg)",
      "file": "server/svencoop/panel.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "hostname",
          "label": "Servername"
        },
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "mp_timelimit",
          "label": "Zeitlimit pro Map (Minuten)",
          "type": "number",
          "min": 0,
          "max": 180
        },
        {
          "key": "mp_friendlyfire",
          "label": "Friendly Fire",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sv_alltalk",
          "label": "Sprachchat für alle",
          "type": "bool",
          "true": "1",
          "false": "0"
        }
      ]
    }
  ],
  "packages": [
    "libssl3:i386",
    "zlib1g:i386"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
