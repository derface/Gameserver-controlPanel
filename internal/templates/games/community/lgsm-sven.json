{
  "id": "lgsm-sven",
  "name": "Sven Co-op",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 276060,
  "start": "./svends_run -game svencoop -strictportbind +ip 0.0.0.0 -port {{port}} +clientport {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg +maxplayers {{maxplayers}}",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "svencoop1",
      "type": "slug"
    }
  ],
  "memory_mb": 512,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "packages": [
    "libssl3:i386",
    "zlib1g:i386"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
