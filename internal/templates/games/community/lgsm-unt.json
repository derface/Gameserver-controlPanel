{
  "id": "lgsm-unt",
  "name": "Unturned",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 1110390,
  "start": "cp -f /opt/steamcmd/linux64/steamclient.so /data/server/; export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/data/server:/data/server/Unturned_Headless_Data/Plugins/x86_64; ./Unturned_Headless.x86_64 -nographics -batchmode -bind 0.0.0.0 -port {{port}} -maxplayers {{maxplayers}} -perspective first -mode {{gamemode}} -name {{servername}} -map {{defaultmap}} -gslt {{gslt}} +InternetServer/panel",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Steam",
      "port": 27016,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "PEI",
      "type": "slug"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "20",
      "type": "number"
    },
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "normal",
      "type": "slug"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    }
  ],
  "memory_mb": 4096,
  "min_memory_mb": 512,
  "console": "stdin",
  "ready": "Loading level: 100%",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
