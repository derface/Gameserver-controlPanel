{
  "id": "lgsm-bmdm",
  "name": "Black Mesa: Deathmatch",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 346680,
  "start": "./srcds_run -game bms -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +sv_setsteamaccount {{gslt}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}}",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "dm_bounce",
      "type": "slug"
    },
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "packages": [
    "libncurses5:i386"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
