{
  "id": "lgsm-sm",
  "name": "Soulmask",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 3017300,
  "start": "cd WS/Binaries/Linux && export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/data/server:/data/server/linux64; ./WSServer-Linux-Shipping WS {{defaultmap}} -MultiHome=0.0.0.0 -Port={{port}} -EchoPort={{port_4}} -QueryPort={{port_3}} -SteamServerName='{{servername}}' -PSW='{{serverpassword}}' -adminpsw='{{adminpassword}}' -MaxPlayers={{maxplayers}} -initbackup -backupinterval=15 -UTF8Output -forcepassthrough -log",
  "ports": [
    {
      "name": "Game",
      "port": 8777,
      "proto": "udp"
    },
    {
      "name": "Game",
      "port": 8777,
      "proto": "tcp"
    },
    {
      "name": "Query",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Telnet",
      "port": 18888,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "Level01_Main",
      "type": "slug"
    },
    {
      "key": "adminpassword",
      "label": "Admin-Passwort",
      "default": "",
      "type": "secret"
    },
    {
      "key": "serverpassword",
      "label": "Server-Passwort",
      "default": "",
      "type": "secret"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "50",
      "type": "number"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 2
  },
  "ready": "Bringing up level for play took",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
