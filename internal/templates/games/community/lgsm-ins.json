{
  "id": "lgsm-ins",
  "name": "Insurgency",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 237410,
  "start": "sed -i 's/\\r$//' srcds_run; mkdir -p bin && cp -f /opt/steamcmd/linux32/steamclient.so bin/; export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/data/server:/data/server/bin; ./srcds_run -game insurgency -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} -tickrate {{tickrate}} +sv_setsteamaccount {{gslt}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -workshop -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "tickrate",
      "label": "Tickrate",
      "default": "64",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "embassy_coop checkpoint",
      "type": "slug"
    },
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "32",
      "type": "number"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "status": "experimentell",
  "notes": "Automatisch aus LinuxGSM übernommen."
}
