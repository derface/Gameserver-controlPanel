{
  "id": "lgsm-jbep3",
  "name": "Jabroni Brawl: Episode 3",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 869800,
  "start": "./srcds_run.sh -game jbep3 -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}}",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "24",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "crossfire",
      "type": "slug"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
