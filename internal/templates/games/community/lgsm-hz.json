{
  "id": "lgsm-hz",
  "name": "Humanitz",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 2728330,
  "steam_beta": "linuxbranch",
  "start": "cd HumanitZServer/Binaries/Linux && ./HumanitZServer-Linux-Shipping -log -port={{port}} -queryport={{port_2}} -steamservername={{servername}}",
  "ports": [
    {
      "name": "Game",
      "port": 7777,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "RCON",
      "port": 7779,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
