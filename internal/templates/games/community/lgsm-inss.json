{
  "id": "lgsm-inss",
  "name": "Insurgency: Sandstorm",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 581330,
  "start": "cd Insurgency/Binaries/Linux && ./InsurgencyServer-Linux-Shipping {{defaultmap}}?Scenario=Scenario_Refinery_Push_Security?MaxPlayers={{maxplayers}} -Port={{port}} -QueryPort={{port_2}} -hostname='{{servername}}' -Rcon -RconPassword={{rconpassword}} -RconListenPort={{port_3}} -GSLTToken={{gslt}} -log",
  "ports": [
    {
      "name": "Game",
      "port": 27102,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 27131,
      "proto": "udp"
    },
    {
      "name": "RCON",
      "port": 27015,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "28",
      "type": "number"
    },
    {
      "key": "rconpassword",
      "label": "RCON-Passwort",
      "default": "",
      "type": "secret"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "Oilfield",
      "type": "slug"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "ready": "Bringing up level for play took",
  "status": "experimentell",
  "notes": "Automatisch aus LinuxGSM übernommen."
}
