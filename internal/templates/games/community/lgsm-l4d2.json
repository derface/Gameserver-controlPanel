{
  "id": "lgsm-l4d2",
  "name": "Left 4 Dead 2",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 222860,
  "steam_preplatform": "windows",
  "start": "./srcds_run -game left4dead2 -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "8",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "c5m1_waterfront",
      "type": "slug"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (left4dead2/cfg/panel.cfg)",
      "file": "server/left4dead2/cfg/panel.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "hostname",
          "label": "Servername"
        },
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "mp_timelimit",
          "label": "Zeitlimit pro Map (Minuten)",
          "type": "number",
          "min": 0,
          "max": 180
        },
        {
          "key": "mp_friendlyfire",
          "label": "Friendly Fire",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sv_alltalk",
          "label": "Sprachchat für alle",
          "type": "bool",
          "true": "1",
          "false": "0"
        }
      ]
    }
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
