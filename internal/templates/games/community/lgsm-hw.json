{
  "id": "lgsm-hw",
  "name": "Hurtworld",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 405100,
  "start": "./Hurtworld.x86_64 -batchmode -nographics -logfile /data/logs/panel-game.log -exec \"host {{port}} {{defaultmap}} ;queryport {{port_2}};maxplayers {{maxplayers}};servername {{servername}};creativemode 0;addadmin \"",
  "ports": [
    {
      "name": "Game",
      "port": 12871,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 12881,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "20",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "nullius",
      "type": "slug"
    }
  ],
  "memory_mb": 4096,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "packages": [
    "lib32z1"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
