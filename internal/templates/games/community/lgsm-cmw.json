{
  "id": "lgsm-cmw",
  "name": "Chivalry: Medieval Warfare",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 220070,
  "start": "cd Binaries/Linux && ./UDKGameServer-Linux {{defaultmap}}?steamsockets -multihome=0.0.0.0 -Port={{port}} -QueryPort={{port_2}} -seekfreeloadingserver -configsubdir=panel -log=/data/logs/panel-game.log",
  "ports": [
    {
      "name": "Game",
      "port": 7777,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 7779,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "AOCTD-Frigid_p",
      "type": "slug"
    }
  ],
  "memory_mb": 2048,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
