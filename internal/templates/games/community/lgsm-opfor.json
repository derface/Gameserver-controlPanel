{
  "id": "lgsm-opfor",
  "name": "Opposing Force",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 90,
  "steam_mod": "gearbox",
  "start": "./hlds_run -game gearbox -strictportbind +ip 0.0.0.0 -port {{port}} +clientport {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "op4_bootcamp",
      "type": "slug"
    }
  ],
  "memory_mb": 512,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "status": "experimentell",
  "notes": "Automatisch aus LinuxGSM übernommen."
}
