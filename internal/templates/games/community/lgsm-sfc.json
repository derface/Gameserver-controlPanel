{
  "id": "lgsm-sfc",
  "name": "SourceForts Classic",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 244310,
  "start": "./srcds_run -game sfclassic -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}}",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "32",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "sf_astrodome",
      "type": "slug"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "packages": [
    "libtinfo5:i386"
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen und noch nicht im Panel getestet."
}
