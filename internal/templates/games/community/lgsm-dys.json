{
  "id": "lgsm-dys",
  "name": "Dystopia",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 17585,
  "start": "cd bin && ./srcds_run.sh -game \"/data/server/dystopia\" -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +map {{defaultmap}} +sv_setsteamaccount {{gslt}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "dys_broadcast",
      "type": "slug"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (dystopia/cfg/panel.cfg)",
      "file": "server/dystopia/cfg/panel.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "hostname",
          "label": "Servername"
        },
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "mp_timelimit",
          "label": "Zeitlimit pro Map (Minuten)",
          "type": "number",
          "min": 0,
          "max": 180
        },
        {
          "key": "mp_friendlyfire",
          "label": "Friendly Fire",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sv_alltalk",
          "label": "Sprachchat für alle",
          "type": "bool",
          "true": "1",
          "false": "0"
        }
      ]
    }
  ],
  "status": "defekt",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest 01.10.2026: Segmentation fault beim Start."
}
