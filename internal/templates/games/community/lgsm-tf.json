{
  "id": "lgsm-tf",
  "name": "The Front",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 2334200,
  "start": "cd ProjectWar/Binaries/Linux && ./TheFrontServer ProjectWar_Start?DedicatedServer?MaxPlayers={{maxplayers}} -server -game -log -MultiHome=0.0.0.0 -Port={{port}} -QueryPort={{port_2}} -BeaconPort={{port_3}} -ShutDownServicePort={{port_4}} -ConfigServerName='panel' -OutIPAddress= -ServerTags='LinuxGSM' -UseSteamSocket=0 -UserDir='/data/server/panel' -ServerName='{{servername}}' -EnableParallelCharacterMovementTickFunction -EnableParallelCharacterTickFunction -UseDynamicPhysicsScene -Game.PhysicsVehicle=false -ansimalloc -Game.MaxFrameRate=35 -MaxQueueSize=50 -QueueValidTime=120 -QueueThreshold={{maxplayers}} -ServerFightModeType={{gamemode}} -IsCanSelfDamage=true -IsCanFriendDamage= -SaveWorldInterval=300 -GMOverlapRatio=2 -GreenHand=true -SensitiveWords=true -UseEAC=true -ServerAdminAccounts='' -IsShowGmTitle=true -ServerPassword='{{serverpassword}}'",
  "ports": [
    {
      "name": "Game",
      "port": 5001,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Beacon",
      "port": 5002,
      "proto": "udp"
    },
    {
      "name": "Shutdown",
      "port": 5003,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "serverpassword",
      "label": "Server-Passwort",
      "default": "",
      "type": "secret"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "0",
      "type": "slug"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "40",
      "type": "number"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "ready": "Bringing up level for play took",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
