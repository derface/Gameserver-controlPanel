{
  "id": "lgsm-ark",
  "name": "ARK: Survival Evolved",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 376030,
  "start": "cd ShooterGame/Binaries/Linux && ./ShooterGameServer {{defaultmap}}?AltSaveDirectoryName={{defaultmap}} -MultiHome=0.0.0.0 -Port={{port}} -QueryPort={{port_3}} -AutoManagedMods -Crossplay -PublicIPForEpic=",
  "ports": [
    {
      "name": "Game",
      "port": 7777,
      "proto": "udp"
    },
    {
      "name": "RAW UDP Socket",
      "port": 7778,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 27015,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "TheIsland",
      "type": "slug"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 2
  },
  "config": [
    {
      "title": "ARK (GameUserSettings.ini)",
      "file": "server/ShooterGame/Saved/Config/LinuxServer/GameUserSettings.ini",
      "format": "ini",
      "note": "Die Datei entsteht beim ersten Start. ARK schreibt sie beim Beenden neu, deshalb stoppt das Panel den Server vor dem Speichern.",
      "settings": [
        {
          "key": "SessionSettings/SessionName",
          "label": "Servername"
        },
        {
          "key": "ServerSettings/ServerPassword",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "ServerSettings/ServerAdminPassword",
          "label": "Admin-Passwort",
          "type": "secret"
        },
        {
          "key": "/Script/Engine.GameSession/MaxPlayers",
          "label": "Maximale Spieler",
          "type": "number",
          "min": 1,
          "max": 200
        },
        {
          "key": "ServerSettings/ServerPVE",
          "label": "PvE (kein PvP)",
          "type": "bool",
          "true": "True",
          "false": "False"
        },
        {
          "key": "ServerSettings/DifficultyOffset",
          "label": "Schwierigkeit (0 bis 1)",
          "type": "number",
          "min": 0,
          "max": 1
        },
        {
          "key": "ServerSettings/XPMultiplier",
          "label": "Erfahrung (Faktor)",
          "type": "number",
          "min": 0.1,
          "max": 100
        },
        {
          "key": "ServerSettings/TamingSpeedMultiplier",
          "label": "Zähmen (Faktor)",
          "type": "number",
          "min": 0.1,
          "max": 100
        },
        {
          "key": "ServerSettings/HarvestAmountMultiplier",
          "label": "Ernte (Faktor)",
          "type": "number",
          "min": 0.1,
          "max": 100
        },
        {
          "key": "ServerSettings/ShowMapPlayerLocation",
          "label": "Eigene Position auf der Karte",
          "type": "bool",
          "true": "True",
          "false": "False"
        }
      ]
    }
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
