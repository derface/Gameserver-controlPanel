{
  "id": "lgsm-ohd",
  "name": "Operation: Harsh Doorstop",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 950900,
  "start": "cd HarshDoorstop/Binaries/Linux && ./HarshDoorstopServer-Linux-Shipping {{defaultmap}}?MaxPlayers={{maxplayers}} -MultiHome=0.0.0.0 -Port={{port}} -QueryPort={{port_2}} -RconPort={{port_3}} -SteamServerName='{{servername}}' -log",
  "ports": [
    {
      "name": "Game",
      "port": 7777,
      "proto": "udp"
    },
    {
      "name": "Query",
      "port": 27005,
      "proto": "udp"
    },
    {
      "name": "RCON",
      "port": 7778,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "AAS-TestMap",
      "type": "slug"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "servername",
      "label": "Servername",
      "default": "Mein Server",
      "type": "text"
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "ready": "Bringing up level for play took",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
