{
  "id": "lgsm-cs",
  "name": "Counter-Strike 1.6",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 90,
  "start": "./hlds_run -game cstrike -strictportbind +ip 0.0.0.0 -port {{port}} +clientport {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "de_dust2",
      "type": "slug"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    }
  ],
  "memory_mb": 512,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
