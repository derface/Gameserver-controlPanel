{
  "id": "lgsm-hl2dm",
  "name": "Half-Life 2: Deathmatch",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 232370,
  "start": "./srcds_run -game hl2mp -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers {{maxplayers}} -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "dm_lockdown",
      "type": "slug"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
