{
  "id": "lgsm-csgo",
  "name": "Counter-Strike: Global Offensive",
  "category": "Steam (Community)",
  "kind": "steam",
  "steam_app_id": 740,
  "start": "[ -f bin/libgcc_s.so.1 ] && mv bin/libgcc_s.so.1 bin/libgcc_s.so.1.bak; echo -n 730 > steam_appid.txt; ./srcds_run -game csgo -usercon -strictportbind -ip 0.0.0.0 -port {{port}} +clientport {{port_3}} +tv_port {{port_2}} +sv_setsteamaccount {{gslt}} -tickrate {{tickrate}} +map {{defaultmap}} +servercfgfile panel.cfg -maxplayers_override {{maxplayers}} +mapgroup mg_active +game_type 0 +game_mode {{gamemode}} +sv_game_mode_flags 0 +sv_skirmish_id 0 +host_workshop_collection +workshop_start_map -authkey -nobreakpad -norestart",
  "ports": [
    {
      "name": "Game",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "SourceTV",
      "port": 27020,
      "proto": "udp"
    },
    {
      "name": "Client",
      "port": 27005,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "defaultmap",
      "label": "Start-Map",
      "default": "de_mirage",
      "type": "slug"
    },
    {
      "key": "tickrate",
      "label": "Tickrate",
      "default": "64",
      "type": "number"
    },
    {
      "key": "maxplayers",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    },
    {
      "key": "gslt",
      "label": "Game Server Login Token",
      "default": "",
      "type": "secret",
      "help": "Für öffentliche Source-Server: steamcommunity.com/dev/managegameservers"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "0",
      "type": "slug"
    }
  ],
  "memory_mb": 1024,
  "min_memory_mb": 512,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (csgo/cfg/panel.cfg)",
      "file": "server/csgo/cfg/panel.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "hostname",
          "label": "Servername"
        },
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "mp_timelimit",
          "label": "Zeitlimit pro Map (Minuten)",
          "type": "number",
          "min": 0,
          "max": 180
        },
        {
          "key": "mp_friendlyfire",
          "label": "Friendly Fire",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sv_alltalk",
          "label": "Sprachchat für alle",
          "type": "bool",
          "true": "1",
          "false": "0"
        }
      ]
    }
  ],
  "status": "beta",
  "notes": "Automatisch aus LinuxGSM übernommen. Selbsttest bestanden."
}
