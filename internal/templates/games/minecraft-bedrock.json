{
  "id": "minecraft-bedrock",
  "name": "Minecraft Bedrock",
  "category": "Minecraft",
  "kind": "image",
  "image": "itzg/minecraft-bedrock-server:latest",
  "env": {
    "EULA": "TRUE",
    "SERVER_NAME": "{{server_name}}",
    "GAMEMODE": "{{gamemode}}",
    "DIFFICULTY": "{{difficulty}}",
    "MAX_PLAYERS": "{{max_players}}",
    "TZ": "Europe/Berlin"
  },
  "ports": [
    {
      "name": "Spiel",
      "port": 19132,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "server_name",
      "label": "Servername",
      "default": "Mein Bedrock-Server"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "survival",
      "type": "select",
      "options": [
        "survival",
        "creative",
        "adventure"
      ]
    },
    {
      "key": "difficulty",
      "label": "Schwierigkeit",
      "default": "normal",
      "type": "select",
      "options": [
        "peaceful",
        "easy",
        "normal",
        "hard"
      ]
    },
    {
      "key": "max_players",
      "label": "Maximale Spieler",
      "default": "10",
      "type": "number"
    }
  ],
  "memory_mb": 2048,
  "min_memory_mb": 1024,
  "console": "exec",
  "exec_prefix": [
    "send-command"
  ],
  "ready": "Server started",
  "query": {"type": "bedrock", "port": 0},
  "status": "stabil",
  "disk_gb": 2,
  "notes": "Für Handy, Konsole und Windows-Edition.",
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Spielwelt (server.properties)",
      "file": "server.properties",
      "format": "properties",
      "settings": [
        {
          "key": "allow-cheats",
          "label": "Cheats erlauben",
          "type": "bool"
        },
        {
          "key": "allow-list",
          "label": "Nur Spieler auf der Allowlist",
          "type": "bool"
        },
        {
          "key": "view-distance",
          "label": "Sichtweite (Chunks)",
          "type": "number",
          "min": 5,
          "max": 96
        },
        {
          "key": "tick-distance",
          "label": "Simulationsweite (Chunks)",
          "type": "number",
          "min": 4,
          "max": 12
        },
        {
          "key": "player-idle-timeout",
          "label": "Inaktive Spieler kicken nach (Minuten, 0 = nie)",
          "type": "number",
          "min": 0,
          "max": 1440
        },
        {
          "key": "level-seed",
          "label": "Seed",
          "type": "text",
          "help": "Gilt nur für neue Welten"
        }
      ]
    }
  ]
}
