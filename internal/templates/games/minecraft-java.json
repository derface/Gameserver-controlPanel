{
  "id": "minecraft-java",
  "name": "Minecraft Java",
  "category": "Minecraft",
  "kind": "image",
  "image": "itzg/minecraft-server:latest",
  "env": {
    "EULA": "TRUE",
    "TYPE": "{{type}}",
    "VERSION": "{{version}}",
    "MAX_PLAYERS": "{{max_players}}",
    "MOTD": "{{motd}}",
    "DIFFICULTY": "{{difficulty}}",
    "VIEW_DISTANCE": "{{view_distance}}",
    "ONLINE_MODE": "{{online_mode}}",
    "MODRINTH_PROJECTS": "{{mods}}",
    "ENABLE_RCON": "true",
    "TZ": "Europe/Berlin"
  },
  "ports": [
    {"name": "Spiel", "port": 25565, "proto": "tcp"}
  ],
  "vars": [
    {"key": "type", "label": "Server-Art", "default": "PAPER", "type": "select", "options": ["PAPER", "VANILLA", "FABRIC", "NEOFORGE", "FORGE", "PURPUR"]},
    {"key": "version", "label": "Minecraft-Version", "default": "LATEST", "help": "z. B. 1.21.1 oder LATEST"},
    {"key": "max_players", "label": "Maximale Spieler", "default": "20", "type": "number"},
    {"key": "motd", "label": "Nachricht in der Serverliste", "default": "Ein Server von [Panel]"},
    {"key": "difficulty", "label": "Schwierigkeit", "default": "normal", "type": "select", "options": ["peaceful", "easy", "normal", "hard"]},
    {"key": "view_distance", "label": "Sichtweite (Chunks)", "default": "10", "type": "number"},
    {"key": "online_mode", "label": "Nur Original-Accounts", "default": "true", "type": "select", "options": ["true", "false"]},
    {"key": "mods", "label": "Mods/Plugins von Modrinth", "default": "", "help": "Kommagetrennte Modrinth-Namen, z. B. create,ferrite-core,modernfix"}
  ],
  "memory_mb": 4096,
  "min_memory_mb": 1536,
  "java_memory_env": "MEMORY",
  "console": "exec",
  "exec_prefix": ["rcon-cli"],
  "stop_timeout": 60,
  "ready": "Done \\(",
  "query": {"type": "minecraft", "port": 0},
  "backup_exclude": ["libraries", "versions", ".cache", "logs", "crash-reports"],
  "backup_pre": ["save-off", "save-all flush"],
  "backup_post": ["save-on"],
  "status": "stabil",
  "disk_gb": 3,
  "notes": "Nutzt das bewährte Image itzg/minecraft-server. Mods werden beim Start automatisch von Modrinth geladen."
}
