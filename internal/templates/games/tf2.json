{
  "id": "tf2",
  "name": "Team Fortress 2",
  "category": "Steam",
  "kind": "steam",
  "steam_app_id": 232250,
  "start": "[ -f bin/linux64/replay_srv.so ] && rm -f bin/replay_srv.so; ./srcds_run_64 -game tf -nohltv -console -norestart -port {{port}} +maxplayers {{max_players}} +map {{map}} +hostname \"{{server_name}}\"",
  "ports": [
    {
      "name": "Spiel",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "RCON",
      "port": 27015,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "server_name",
      "label": "Servername",
      "default": "Mein TF2-Server"
    },
    {
      "key": "map",
      "label": "Start-Map",
      "default": "ctf_2fort",
      "type": "slug"
    },
    {
      "key": "max_players",
      "label": "Maximale Spieler",
      "default": "24",
      "type": "number"
    }
  ],
  "memory_mb": 2048,
  "min_memory_mb": 1024,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "backup_include": [
    "server/tf/cfg"
  ],
  "status": "experimentell",
  "disk_gb": 15,
  "notes": "Läuft als 64-Bit-Server; die alte 32-Bit-Datei replay_srv.so wird vor dem Start entfernt.",
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (tf/cfg/server.cfg)",
      "file": "server/tf/cfg/server.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "mp_timelimit",
          "label": "Zeitlimit pro Map (Minuten)",
          "type": "number",
          "min": 0,
          "max": 180
        },
        {
          "key": "mp_maxrounds",
          "label": "Runden pro Map (0 = egal)",
          "type": "number",
          "min": 0,
          "max": 60
        },
        {
          "key": "mp_autoteambalance",
          "label": "Teams automatisch ausgleichen",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sv_alltalk",
          "label": "Sprachchat für alle",
          "type": "bool",
          "true": "1",
          "false": "0"
        }
      ]
    }
  ],
  "packages": [
    "libcurl3-gnutls",
    "libcurl3-gnutls:i386"
  ]
}
