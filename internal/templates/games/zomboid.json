{
  "id": "zomboid",
  "name": "Project Zomboid",
  "category": "Steam",
  "kind": "steam",
  "steam_app_id": 380870,
  "start": "./start-server.sh -servername {{server_name}} -adminpassword \"{{admin_password}}\" -port {{port}} -udpport {{port_2}}",
  "ports": [
    {
      "name": "Spiel",
      "port": 16261,
      "proto": "udp"
    },
    {
      "name": "Direkt",
      "port": 16262,
      "proto": "udp"
    }
  ],
  "vars": [
    {
      "key": "server_name",
      "label": "Servername (ohne Leerzeichen)",
      "default": "panel",
      "type": "slug"
    },
    {
      "key": "admin_password",
      "label": "Admin-Passwort",
      "default": "",
      "type": "secret",
      "required": true
    }
  ],
  "memory_mb": 6144,
  "min_memory_mb": 3072,
  "console": "stdin",
  "stop_timeout": 45,
  "ready": "SERVER STARTED",
  "status": "beta",
  "disk_gb": 5,
  "notes": "Konfiguration liegt in Zomboid/Server/<servername>.ini im Home-Verzeichnis des Containers.",
  "broadcast": "servermsg \"{{msg}}\"",
  "config": [
    {
      "title": "Project Zomboid (Server-INI)",
      "file": "home/Zomboid/Server/{{server_name}}.ini",
      "format": "properties",
      "note": "Die Datei entsteht beim ersten Start.",
      "settings": [
        {
          "key": "PublicName",
          "label": "Name in der Serverliste"
        },
        {
          "key": "PublicDescription",
          "label": "Beschreibung"
        },
        {
          "key": "Password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "MaxPlayers",
          "label": "Maximale Spieler",
          "type": "number",
          "min": 1,
          "max": 100
        },
        {
          "key": "Public",
          "label": "In der Serverliste zeigen",
          "type": "bool"
        },
        {
          "key": "Open",
          "label": "Jeder darf beitreten",
          "type": "bool",
          "help": "Aus = nur Spieler mit Konto auf dem Server"
        },
        {
          "key": "PVP",
          "label": "PvP",
          "type": "bool"
        },
        {
          "key": "PauseEmpty",
          "label": "Pause ohne Spieler",
          "type": "bool"
        },
        {
          "key": "GlobalChat",
          "label": "Globaler Chat",
          "type": "bool"
        },
        {
          "key": "SafetySystem",
          "label": "PvP-Schutzschalter",
          "type": "bool"
        },
        {
          "key": "SleepAllowed",
          "label": "Schlafen erlaubt",
          "type": "bool"
        },
        {
          "key": "WorkshopItems",
          "label": "Workshop-IDs",
          "help": "Steam-Workshop-Nummern, mit Semikolon getrennt, z. B. 2169435993;2392709985. Der Server lädt sie beim Start selbst."
        },
        {
          "key": "Mods",
          "label": "Mod-IDs",
          "help": "Die Mod-ID aus der Workshop-Beschreibung, mit Semikolon getrennt. Gehört zu den Workshop-IDs oben."
        },
        {
          "key": "Map",
          "label": "Karte",
          "help": "Standard: Muldraugh, KY. Weitere Karten aus Mods mit Semikolon davor."
        }
      ]
    }
  ]
}
