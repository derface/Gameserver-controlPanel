{
  "id": "gmod",
  "name": "Garry's Mod",
  "category": "Steam",
  "kind": "steam",
  "steam_app_id": 4020,
  "start": "./srcds_run -game garrysmod -console -norestart -port {{port}} +maxplayers {{max_players}} +map {{map}} +gamemode {{gamemode}} +hostname \"{{server_name}}\"",
  "ports": [
    {
      "name": "Spiel",
      "port": 27015,
      "proto": "udp"
    },
    {
      "name": "RCON",
      "port": 27015,
      "proto": "tcp"
    }
  ],
  "vars": [
    {
      "key": "server_name",
      "label": "Servername",
      "default": "Mein GMod-Server"
    },
    {
      "key": "map",
      "label": "Start-Map",
      "default": "gm_construct",
      "type": "slug"
    },
    {
      "key": "gamemode",
      "label": "Spielmodus",
      "default": "sandbox",
      "type": "slug"
    },
    {
      "key": "max_players",
      "label": "Maximale Spieler",
      "default": "16",
      "type": "number"
    }
  ],
  "memory_mb": 2048,
  "min_memory_mb": 1024,
  "console": "stdin",
  "ready": "VAC secure mode",
  "query": {
    "type": "a2s",
    "port": 0
  },
  "backup_include": [
    "server/garrysmod/data",
    "server/garrysmod/cfg",
    "server/garrysmod/addons"
  ],
  "status": "experimentell",
  "disk_gb": 5,
  "notes": " Selbsttest 01.10.2026: startet, meldet aber nicht „bereit“, wird noch untersucht.",
  "packages": [
    "libtinfo5:i386"
  ],
  "broadcast": "say {{msg}}",
  "config": [
    {
      "title": "Server (garrysmod/cfg/server.cfg)",
      "file": "server/garrysmod/cfg/server.cfg",
      "format": "cvar",
      "settings": [
        {
          "key": "sv_password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "rcon_password",
          "label": "RCON-Passwort",
          "type": "secret"
        },
        {
          "key": "sbox_noclip",
          "label": "Noclip erlauben",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sbox_godmode",
          "label": "Unverwundbar",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sbox_playershurtplayers",
          "label": "Spieler können sich verletzen",
          "type": "bool",
          "true": "1",
          "false": "0"
        },
        {
          "key": "sbox_maxprops",
          "label": "Max. Props pro Spieler",
          "type": "number",
          "min": 0,
          "max": 2000
        },
        {
          "key": "sv_loadingurl",
          "label": "Ladebildschirm-URL"
        }
      ]
    }
  ]
}
