{
  "id": "sotf",
  "name": "Sons of the Forest",
  "category": "Steam (Windows, Wine)",
  "kind": "steam",
  "steam_app_id": 2465200,
  "platform": "windows",
  "runtime": "wine",
  "start": "xvfb-run -a wine ./SonsOfTheForestDS.exe -userdatapath /data/server/userdata -logFile /data/logs/sotf.log",
  "ports": [
    {
      "name": "Spiel",
      "port": 8766,
      "proto": "udp"
    },
    {
      "name": "Abfrage",
      "port": 27016,
      "proto": "udp"
    },
    {
      "name": "Blob-Sync",
      "port": 9700,
      "proto": "udp"
    }
  ],
  "fixed_ports": true,
  "vars": [],
  "memory_mb": 8192,
  "min_memory_mb": 6144,
  "console": "stdin",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "backup_include": [
    "server/userdata"
  ],
  "status": "experimentell",
  "disk_gb": 5,
  "notes": "Läuft über Wine. Einstellungen in userdata/dedicatedserver.cfg (entsteht beim ersten Start). Selbsttest 01.10.2026: stürzt unter Wine kurz nach dem Start ab, wird noch untersucht.",
  "log_file": "/data/logs/sotf.log",
  "config": [
    {
      "title": "Sons of the Forest (dedicatedserver.cfg)",
      "file": "server/userdata/dedicatedserver.cfg",
      "format": "json",
      "settings": [
        {
          "key": "ServerName",
          "label": "Servername"
        },
        {
          "key": "Password",
          "label": "Passwort",
          "type": "secret"
        },
        {
          "key": "MaxPlayers",
          "label": "Maximale Spieler",
          "type": "number",
          "min": 1,
          "max": 8
        },
        {
          "key": "GameMode",
          "label": "Spielmodus",
          "type": "select",
          "options": [
            "Normal",
            "Hard",
            "HardSurvival",
            "Peaceful",
            "Custom"
          ],
          "labels": [
            "Normal",
            "Schwer",
            "Harte Survival",
            "Friedlich",
            "Eigene"
          ]
        },
        {
          "key": "SaveSlot",
          "label": "Speicherplatz",
          "type": "number",
          "min": 1,
          "max": 30
        },
        {
          "key": "SaveMode",
          "label": "Spielstand",
          "type": "select",
          "options": [
            "Continue",
            "New"
          ],
          "labels": [
            "Fortsetzen",
            "Neu beginnen"
          ]
        },
        {
          "key": "SaveInterval",
          "label": "Speichern alle … Sekunden",
          "type": "number",
          "min": 60,
          "max": 3600
        },
        {
          "key": "LanOnly",
          "label": "Nur im LAN",
          "type": "bool"
        }
      ]
    }
  ]
}
