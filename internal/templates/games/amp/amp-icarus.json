        "Leicht",
        "Mittel / Normal (Standard)",
        "Schwer",
        "Extrem"
      ]
    },
    {
      "key": "hardcore",
      "label": "Hardcore",
      "help": "Wenn an, ist bei neuen Prospects der Hardcore-Modus aktiv (kein Respawn).",
      "type": "select",
      "options": [
        "True",
        "False"
      ],
      "labels": [
        "An",
        "Aus"
      ],
      "default": "False"
    },
    {
      "key": "prospect_save_name",
      "label": "Name der Prospect",
      "help": "Speichername der Prospect, die geladen bzw. angelegt wird.",
      "default": "DefaultProspect01"
    },
    {
      "key": "startup_mode",
      "label": "Startmodus",
      "help": "Wie der Server startet. Bei „Bestehende Prospect laden“ muss der Speichername gesetzt sein und die Datei existieren. Bei „Neue Prospect anlegen“ muss die Prospect-Art gesetzt sein; ohne Speichername wird bei normalen Prospects ein zufälliger erzeugt.",
      "type": "select",
      "options": [
        "",
        "-CreateProspect=\"{{prospect_type}} {{difficulty}} {{hardcore}} {{prospect_save_name}}\"",
        "-LoadProspect=\"{{prospect_save_name}}\"",
        "-ResumeProspect"
      ],
      "default": "",
      "labels": [
        "In der Lobby warten",
        "Create and launch new prospect (default)",
        "Load existing prospect",
        "Letzte Prospect fortsetzen"
      ]
    }
