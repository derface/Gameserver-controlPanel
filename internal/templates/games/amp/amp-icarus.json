  "amp_import": {
    "vars": {
      "startup_mode": "-ResumeProspect"
    }
  },
  "memory_mb": 6144,
  "min_memory_mb": 2048,
  "console": "stdin",
  "ready": "^\\[[\\d\\.]+-[\\d\\.:]+\\]\\[[\\d ]+\\]LogInit: Display: Game Engine Initialized\\.$",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "backup_include": [
    "server/Icarus/Saved"
  ],
  "config": [
    {
      "title": "ServerSettings.ini",
      "file": "server/Icarus/Saved/Config/WindowsServer/ServerSettings.ini",
      "format": "ini",
      "write_default": true,
      "default": "[/Script/Icarus.DedicatedServerSettings]\nSessionName=AMP Powered Icarus Server\nJoinPassword=\nMaxPlayers=8\nAdminPassword=Password123\nShutdownIfNotJoinedFor=300\nShutdownIfEmptyFor=300\nAllowNonAdminsToLaunchProspects=True\nAllowNonAdminsToDeleteProspects=False\nLoadProspect=\nCreateProspect=\nResumeProspect=False\nLastProspectName=\nFiberFoliageRespawn=True\nLargeStonesRespawn=True\nGameSaveFrequency=10.000000\nSaveGameOnExit=True\n",
      "settings": []
    }
  ],
  "status": "experimentell",
  "notes": "Aus den AMP-Vorlagen von CubeCoders erzeugt (MIT), noch nicht im Selbsttest geprüft. Läuft über Wine."
}
