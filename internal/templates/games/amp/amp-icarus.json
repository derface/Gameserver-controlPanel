{
  "id": "amp-icarus",
  "name": "Icarus",
  "category": "Steam (Windows, Wine)",
  "kind": "steam",
  "steam_app_id": 2089300,
  "platform": "windows",
  "runtime": "wine",
  "start": "mkdir -p \"Icarus/Saved/Config/WindowsServer\" ; SteamAppId=\"1149460\" wine \"./Icarus/Binaries/Win64/IcarusServer-Win64-Shipping.exe\" Icarus -ini:Engine:[OnlineSubsystemSteam]:AsyncTaskTimeout={{async_task_timeout}} -Port={{port}} -QueryPort={{port_2}} {{startup_mode}} {{session_name}} -JoinPassword=\"{{join_password}}\" -AdminPassword=\"{{admin_password}}\" -log=Icarus.log",
  "ports": [
    {
      "name": "Spiel",
      "port": 17777,
      "proto": "udp"
    },
    {
      "name": "Abfrage",
      "port": 27015,
      "proto": "udp"
    }
  ],
