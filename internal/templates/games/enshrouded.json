{
  "id": "enshrouded",
  "name": "Enshrouded",
  "category": "Steam (Windows, Wine)",
  "kind": "steam",
  "steam_app_id": 2278520,
  "platform": "windows",
  "runtime": "wine",
  "start": "wine ./enshrouded_server.exe",
  "ports": [
    {
      "name": "Spiel",
      "port": 15636,
      "proto": "udp"
    },
    {
      "name": "Abfrage",
      "port": 15637,
      "proto": "udp"
    },
    {
      "name": "Spiel (TCP)",
      "port": 15636,
      "proto": "tcp"
    },
    {
      "name": "Abfrage (TCP)",
      "port": 15637,
      "proto": "tcp"
    }
  ],
  "fixed_ports": true,
  "vars": [],
  "memory_mb": 12288,
  "min_memory_mb": 6144,
  "console": "stdin",
  "ready": "HostOnline",
  "query": {
    "type": "a2s",
    "port": 1
  },
  "backup_include": [
    "server/savegame",
    "server/enshrouded_server.json"
  ],
  "status": "stabil",
  "disk_gb": 4,
  "notes": "Läuft über Wine. Name, Passwörter und Spielerzahl stellst du unter „Einstellungen“ ein. Taucht der Server im Spiel nicht auf: Steam → Anzeigen → Spielserver → Favoriten → Server hinzufügen mit IP:15637. Für Spieler von außen 15636 und 15637 (UDP und TCP) im Router weiterleiten.",
  "config": [
    {
      "title": "Enshrouded (enshrouded_server.json)",
      "file": "server/enshrouded_server.json",
      "format": "json",
      "note": "Wer welches Passwort eingibt, landet in der Gruppe: Admin, Freund, Gast oder Besucher. Enshrouded verlangt verschiedene Passwörter; nur „Besucher“ darf leer sein. Neue Server bekommen zufällige Passwörter – trag deine eigenen ein, bevor du sie weitergibst.",
      "settings": [
        {
          "key": "name",
          "label": "Servername"
        },
        {
          "key": "slotCount",
          "label": "Spielerplätze",
          "type": "number",
          "min": 1,
          "max": 16
        },
        {
          "key": "gameSettingsPreset",
          "label": "Spielregeln",
          "type": "select",
          "options": [
            "Default",
            "Relaxed",
            "Hard",
            "Survival",
            "Custom"
          ],
          "labels": [
            "Standard",
            "Entspannt",
            "Schwer",
            "Survival",
            "Eigene"
          ]
        },
        {
          "key": "userGroups.0.password",
          "label": "Passwort Admin",
          "type": "secret"
        },
        {
          "key": "userGroups.1.password",
          "label": "Passwort Freund",
          "type": "secret"
        },
        {
          "key": "userGroups.2.password",
          "label": "Passwort Gast",
          "type": "secret"
        },
        {
          "key": "userGroups.3.password",
          "label": "Passwort Besucher",
          "type": "secret"
        },
        {
          "key": "enableVoiceChat",
          "label": "Sprachchat",
          "type": "bool"
        },
        {
          "key": "enableTextChat",
          "label": "Textchat",
          "type": "bool"
        }
      ],
      "default": {
        "name": "Enshrouded Server",
        "saveDirectory": "./savegame",
        "logDirectory": "./logs",
        "ip": "0.0.0.0",
        "queryPort": 15637,
        "slotCount": 16,
        "gameSettingsPreset": "Default",
        "enableVoiceChat": false,
        "enableTextChat": false,
        "userGroups": [
          {
            "name": "Admin",
            "password": "{{random}}",
            "canKickBan": true,
            "canAccessInventories": true,
            "canEditBase": true,
            "canExtendBase": true,
            "reservedSlots": 0
          },
          {
            "name": "Friend",
            "password": "{{random}}",
            "canKickBan": false,
            "canAccessInventories": true,
            "canEditBase": true,
            "canExtendBase": true,
            "reservedSlots": 0
          },
          {
            "name": "Guest",
            "password": "{{random}}",
            "canKickBan": false,
            "canAccessInventories": false,
            "canEditBase": true,
            "canExtendBase": false,
            "reservedSlots": 0
          },
          {
            "name": "Visitor",
            "password": "{{random}}",
            "canKickBan": false,
            "canAccessInventories": false,
            "canEditBase": false,
            "canExtendBase": false,
            "reservedSlots": 0
          }
        ]
      },
      "check": "enshrouded_groups"
    }
  ]
}
